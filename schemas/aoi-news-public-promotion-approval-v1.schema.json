{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoifuture.com/schemas/aoi-news-public-promotion-approval-v1.schema.json",
  "title": "AOIFUTURE News public promotion approval v1",
  "description": "Separate authorization binding one reviewed candidate to one public Edition target. It does not deploy, publish, or schedule.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edition_id", "candidate_sha256", "target_publication_status", "approved_at"],
  "properties": {
    "schema_version": { "const": "aoi.news.public-promotion-approval.v1" },
    "edition_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?:-(?:[01][0-9]|2[0-3])[0-5][0-9])?$" },
    "candidate_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_publication_status": { "const": "public" },
    "approved_at": { "type": "string", "format": "date-time" }
  }
}
