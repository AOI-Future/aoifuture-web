{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoifuture.com/schemas/aoi-news-editorial-decision-v1.schema.json",
  "title": "AOIFUTURE News local-only editorial decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "inclusion_decision", "public_fields", "role", "topics", "approved_at"],
  "properties": {
    "schema_version": { "const": "aoi.news.editorial-decision.v1" },
    "candidate_id": { "$ref": "#/$defs/id" },
    "inclusion_decision": { "const": "approved" },
    "public_fields": { "$ref": "#/$defs/publicFields" },
    "role": { "enum": ["lead", "major", "brief", "detour", "watch"] },
    "topics": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "approved_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "text200": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?=[^<>]*\\S)[^<>]*$" },
    "text500": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?=[^<>]*\\S)[^<>]*$" },
    "text1000": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?=[^<>]*\\S)[^<>]*$" },
    "publicFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "source_title", "source_fact", "selection_reason", "aoi_note"],
      "properties": {
        "title": { "$ref": "#/$defs/text200" },
        "source_title": { "$ref": "#/$defs/text500" },
        "source_fact": { "$ref": "#/$defs/text1000" },
        "selection_reason": { "$ref": "#/$defs/text500" },
        "aoi_note": { "$ref": "#/$defs/text1000" },
        "caveat": { "$ref": "#/$defs/text500" }
      }
    }
  }
}
