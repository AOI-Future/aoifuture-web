---
import type { NewsEdition } from '../../lib/news/types';
import { displayEditionTitle } from '../../lib/news/display-title.mjs';

interface Props {
  edition: NewsEdition;
}

const { edition } = Astro.props;
const canonical = `https://www.aoifuture.com/news/${edition.edition_id}/`;
const ogX = `/og/news/${edition.edition_id}-x.png`;

const lead = edition.items.find((i) => i.role === 'lead') ?? edition.items[0];
const truncate = (s: string, n: number) => (s.length > n ? `${s.slice(0, n - 1)}…` : s);
const shareText = [
  `AOIFUTURE News ${edition.edition_date}のまとめ`,
  truncate(lead?.title ?? displayEditionTitle(edition.title), 60),
].join('\n');

const xIntent = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(canonical + '?utm_source=x&utm_medium=share&utm_campaign=edition-share')}`;
const linkedinIntent = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical + '?utm_source=linkedin&utm_medium=share&utm_campaign=edition-share')}`;
const altText = `${displayEditionTitle(edition.title)} — 今日のニュースまとめ画像`;
---

<aside class="news-share" aria-label="今日のまとめ">
  <div class="news-share__head">
    <p class="news-kicker">EXECUTIVE SUMMARY</p>
    <h2>今日のまとめ</h2>
    <p class="news-share__hint">今日の重要ニュースを1枚にまとめました。SNSにシェアしたり、画像として保存できます。</p>
  </div>

  <div class="news-share__card">
    <a href={canonical}>
      <img src={ogX} width="1200" height="630" loading="lazy" alt={altText} />
    </a>
  </div>

  <div class="news-share__actions">
    <a class="news-share__btn news-share__btn--x" href={xIntent} target="_blank" rel="noopener noreferrer">Xでシェア</a>
    <a class="news-share__btn news-share__btn--li" href={linkedinIntent} target="_blank" rel="noopener noreferrer">LinkedInでシェア</a>
    <a class="news-share__btn" href={ogX} download>画像を保存</a>
  </div>
</aside>
