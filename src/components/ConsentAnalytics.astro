---
import Analytics from '@vercel/analytics/astro';
---

<!-- Consent is denied by default; Google Analytics is loaded only after acceptance. -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}

  gtag("consent", "default", {
    analytics_storage: "denied",
    ad_storage: "denied",
    wait_for_update: 500
  });

  function loadGoogleAnalytics() {
    if (document.getElementById("google-analytics-script")) return;
    gtag("js", new Date());
    gtag("config", "G-44419Y68H7");
    var script = document.createElement("script");
    script.id = "google-analytics-script";
    script.async = true;
    script.src = "https://www.googletagmanager.com/gtag/js?id=G-44419Y68H7";
    document.head.appendChild(script);
  }

  if (localStorage.getItem("cookie-consent") === "accepted") {
    gtag("consent", "update", { analytics_storage: "granted" });
    loadGoogleAnalytics();
  }
</script>

<Analytics />

<div id="cookie-banner" style="display:none">
  <div class="cookie-banner__content">
    <p class="cookie-banner__copy">
      このサイトではGoogle Analyticsを使用しています。
      <a href="/privacy">プライバシーポリシー</a>
    </p>
    <div class="cookie-banner__actions">
      <button id="cookie-reject">
        拒否
      </button>
      <button id="cookie-accept">
        同意
      </button>
    </div>
  </div>
</div>
<script is:inline>
  (function() {
    var consent = localStorage.getItem("cookie-consent");
    if (consent) return;
    var banner = document.getElementById("cookie-banner");
    if (banner) banner.style.display = "block";
    document.getElementById("cookie-accept")?.addEventListener("click", function() {
      localStorage.setItem("cookie-consent", "accepted");
      gtag("consent", "update", { analytics_storage: "granted" });
      loadGoogleAnalytics();
      banner.style.display = "none";
    });
    document.getElementById("cookie-reject")?.addEventListener("click", function() {
      localStorage.setItem("cookie-consent", "rejected");
      banner.style.display = "none";
    });
  })();
</script>

<style>
  #cookie-banner {
    position: fixed;
    z-index: 100;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 12px 16px;
    border-top: 1px solid rgb(34 211 238 / 0.3);
    background: rgb(0 0 0 / 0.9);
    color: rgb(103 232 249 / 0.7);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    backdrop-filter: blur(4px);
  }

  .cookie-banner__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: min(100%, 896px);
    margin: 0 auto;
  }

  .cookie-banner__copy {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
  }

  .cookie-banner__copy a {
    color: rgb(34 211 238);
    text-underline-offset: 0.2em;
  }

  .cookie-banner__copy a:hover {
    text-decoration: underline;
  }

  .cookie-banner__actions {
    display: flex;
    flex: 0 0 auto;
    gap: 8px;
  }

  .cookie-banner__actions button {
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid rgb(34 211 238 / 0.3);
    background: transparent;
    color: rgb(34 211 238 / 0.6);
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    line-height: 1;
    transition: border-color 200ms linear, background-color 200ms linear;
  }

  .cookie-banner__actions button:hover {
    border-color: rgb(34 211 238 / 0.6);
  }

  #cookie-accept {
    border-color: rgb(34 211 238 / 0.5);
    background: rgb(34 211 238 / 0.1);
    color: rgb(34 211 238);
  }

  #cookie-accept:hover {
    background: rgb(34 211 238 / 0.2);
  }

  .cookie-banner__actions button:focus-visible,
  .cookie-banner__copy a:focus-visible {
    outline: 2px solid rgb(34 211 238);
    outline-offset: 2px;
  }

  @media (max-width: 639px) {
    .cookie-banner__content {
      align-items: stretch;
      flex-direction: column;
    }

    .cookie-banner__actions {
      justify-content: flex-end;
    }
  }
</style>
