---
import Layout from '../../../layouts/Layout.astro';

export const prerender = true;

const title = 'Hardshell Terms of Service & Legal Notice | AOI Future';
const description =
  'Terms of Service, OSS vs. Solo Guardian license separation, 14-day free trial, billing, disclaimer of warranties, limitation of liability, indemnification, and legal notice for Hardshell.';
---

<Layout
  title={title}
  description={description}
  canonical="https://aoifuture.com/apps/hardshell/terms"
  pageTransition={false}
  lang="en"
>
  <Fragment slot="head">
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://aoifuture.com/apps/hardshell/terms" />
    <meta property="og:locale" content="en_US" />
  </Fragment>

  <main class="hst-shell">
    <nav class="hst-nav" aria-label="Related pages">
      <a href="/apps/hardshell/">{'<'} HARDSHELL</a>
      <div class="hst-nav-links">
        <a href="/apps/hardshell/agent.json">agent.json</a>
        <a href="/contact">Support</a>
        <a href="/legal">AOI Future Legal</a>
      </div>
    </nav>

    <header class="hst-hero">
      <p class="hst-label">HARDSHELL / TERMS OF SERVICE &amp; LEGAL NOTICE</p>
      <h1>Terms of Service, Data Handling &amp; Legal Notice</h1>
      <p class="hst-meta">Last updated: November 22, 2026</p>
      <p class="hst-lead">
        These Terms of Service ("Terms") govern your subscription to and use of <strong>Hardshell Solo Guardian</strong> and related Relay services operated by <strong>AOI Future</strong> ("we", "us", "our"), and clarify the boundary between Solo Guardian and the open-source <strong>Hardshell Community</strong> codebase.
      </p>
    </header>

    <section class="hst-section">
      <h2>1. Scope, Eligibility &amp; OSS Separation</h2>
      <ul>
        <li>
          <strong>Intended Users</strong>: Hardshell Solo Guardian is designed primarily for business, developer, and operational use by solo founders, indie developers, engineers, and organizations managing self-hosted servers and AI agents.
        </li>
        <li>
          <strong>Hardshell Community (Open Source — MIT License)</strong>: The open-source codebase published at <a href="https://github.com/0xshugo/hardshell" target="_blank" rel="noopener noreferrer"><code>github.com/0xshugo/hardshell</code></a> is governed solely by the <strong>MIT License</strong> included in that repository. Its "AS IS" disclaimer and license terms apply independently of these Terms.
        </li>
        <li>
          <strong>Hardshell Solo Guardian (Early Access — Best-Effort, No SLA)</strong>: While your subscription is active, we grant you a non-exclusive, non-transferable right to use the Solo Guardian commercial add-ons—including Ed25519 offline-verifiable entitlements for up to <strong>3 VPS nodes</strong> you are authorized to administer, off-host Out-of-Band Witness, a Public Posture Status / Trust Page (a cryptographically signed self-audit snapshot, not a third-party certification), and the 1-Tap HCAP v0.2 human-approval &amp; rollback broker via <code>hardshell.aoifuture.com</code>. Solo Guardian (including the Founding Supporter tier) is provided on a <strong>best-effort basis with no uptime or support-response SLA</strong>.
        </li>
        <li>
          <strong>Acceptable Use</strong>: You may not share, resell, sublicense, or redistribute your license key, nor use Hardshell to scan, probe, or modify servers, networks, or systems without explicit authorization from their owner.
        </li>
        <li>
          <strong>Order of Precedence</strong>: The MIT License governs the Hardshell Community source code; these Terms govern Solo Guardian subscriptions, billing, Relay services, and all related commercial obligations.
        </li>
      </ul>
    </section>

    <section class="hst-section">
      <h2>2. 14-Day Free Trial, Pricing, Renewal, Cancellation &amp; Refunds</h2>
      <ul>
        <li><strong>14-Day Free Trial</strong>: New subscriptions include a 14-day free trial. Cancel anytime before the trial ends via the Stripe Customer Portal and you will not be charged.</li>
        <li><strong>Pricing (USD)</strong>: Founding tier — <strong>$19/month</strong> or <strong>$190/year</strong>; Standard tier — <strong>$29/month</strong> or <strong>$290/year</strong>. Applicable taxes, currency, and total amounts are displayed on Stripe Checkout before you confirm payment.</li>
        <li><strong>Billing &amp; Auto-Renewal</strong>: Payments are processed by Stripe. Your first charge occurs when the 14-day trial ends, and subscriptions renew automatically at the end of each monthly or annual billing cycle unless canceled beforehand.</li>
        <li><strong>Self-Serve Cancellation</strong>: Cancel or manage your plan anytime via the Stripe Customer Portal. After cancellation, Solo Guardian access continues until the end of the current paid period.</li>
        <li><strong>Refund Policy</strong>: Because every subscription starts with a 14-day free trial, <strong>fees paid after the trial ends are non-refundable and non-prorated</strong>, except in cases of duplicate billing, material service defects attributable to us, or where a refund is required by applicable law. Contact <a href="mailto:legal@aoifuture.com"><code>legal@aoifuture.com</code></a> for billing exceptions.</li>
        <li><strong>Fail-Open Guarantee</strong>: If your subscription ends, expires, or the Relay is unreachable, only commercial Solo Guardian add-ons (new Witness updates, Public Trust Page updates, and 1-Tap HCAP approvals) stop. <strong>Hardshell Community (MIT) scans, your monitored VPS uptime, and local viewing/exporting of existing evidence never stop.</strong></li>
      </ul>
    </section>

    <section class="hst-section">
      <h2>3. License Delivery, Offline Verification &amp; Data Handling</h2>
      <p>
        Immediately after Stripe Checkout completes, we send a one-time license key and setup instructions from <code>noreply@hs-mail.aoifuture.com</code>. The Relay database does not store plaintext license keys—only HMAC digests. If you lose your key, request re-issuance via <a href="/contact">/contact</a>.
      </p>
      <p>
        Activation and refresh issue an Ed25519-signed entitlement token that your client verifies offline using the pinned public key. Out-of-Band Witness endpoints receive only signed posture summaries (<code>hardshell.posture_summary.v1</code>) and node identification metadata; we do not collect your VPS private keys, application source code, or database contents. If you enable a Public Verified Trust Page, posture summaries and verification status under your chosen slug are publicly accessible on the web.
      </p>
      <p>
        Payment card details are handled exclusively by Stripe and never touch our servers. See the <a href="https://stripe.com/privacy" target="_blank" rel="noopener noreferrer">Stripe Privacy Policy</a> for details.
      </p>
    </section>

    <section class="hst-section">
      <h2>4. Service Nature, Customer Responsibilities &amp; Disclaimer of Warranties</h2>
      <p>
        Hardshell (Community and Solo Guardian) and its Public Posture / Trust Pages are <strong>assistive inspection, visibility, and human-approval workflow tools</strong>—not an autonomous security guarantee, managed security service, or third-party certification. All final operational, remediation, and disclosure decisions remain solely with the human operator.
      </p>
      <p class="hst-caps">
        TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, THE SOFTWARE AND SERVICES ARE PROVIDED "AS IS" AND "AS AVAILABLE", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING WITHOUT LIMITATION ANY IMPLIED WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, TITLE, OR NON-INFRINGEMENT.
      </p>
      <p>Without limiting the foregoing, we do not warrant or guarantee:</p>
      <ul>
        <li>Complete detection, prevention, or mitigation of unauthorized access, intrusions, malware, vulnerabilities, data breaches, or downtime.</li>
        <li>Infallible accuracy of heuristic, rule-based, or AI-assisted triage, prioritization, or <code>hardshell guard</code> local guardrails—automated checks and AI models can produce false positives, false negatives, or miss novel prompt injections, runaway loops, or third-party LLM/cloud API billing overruns.</li>
        <li>Third-party security certification or compliance with regulatory or audit frameworks (including SOC 2, ISO/IEC 27001, HIPAA, PCI-DSS, or ISMS).</li>
        <li>Complete system recovery or data preservation via 1-Tap HCAP approvals, pre-change snapshots, or rollback helpers (Hardshell is not a substitute for independent backups).</li>
        <li>Uninterrupted or error-free availability of the Relay service (no SLA is provided), or accuracy/completeness of external vulnerability feeds (EPSS, CISA KEV, OSV/GHSA, vendor advisories).</li>
      </ul>
      <p>
        <strong>Best-Effort Support &amp; No SLA</strong>: The Relay service and email/web support are provided on a best-effort basis without any guaranteed uptime percentage, latency target, or support response-time SLA.
      </p>
      <p>
        <strong>High-Risk &amp; Mission-Critical Use Exclusion</strong>: Hardshell is intended for indie developers, solo founders, and general self-hosted infrastructure inspection—it is <strong>not designed, tested, or authorized for high-risk, safety-critical, or heavily regulated environments</strong> (including medical or life-support systems, financial settlement/custody, critical infrastructure, or environments requiring formal SOC 2, ISO/IEC 27001, HIPAA, or PCI-DSS compliance guarantees). Do not rely on Hardshell as your sole security control or as a substitute for qualified security professionals or independent backups.
      </p>
      <p>
        You remain solely responsible for verifying authorization over target hosts, configuring firewalls and credentials, reviewing and approving changes, maintaining independent backups, responding to security incidents, and deciding what information you disclose via a Public Posture / Trust Page.
      </p>
    </section>

    <section class="hst-section">
      <h2>5. Limitation of Liability</h2>
      <ul>
        <li>
          <strong>Exclusion of Indirect &amp; Consequential Damages</strong>: TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, IN NO EVENT SHALL AOI FUTURE BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, EXEMPLARY, OR PUNITIVE DAMAGES, OR FOR ANY LOSS OF PROFITS, REVENUE, BUSINESS OPPORTUNITY, GOODWILL, OR DATA, AI/CLOUD API COST OVERRUNS, OR SECURITY BREACH DAMAGES ARISING OUT OF OR RELATED TO THE SOFTWARE OR SERVICES, WHETHER IN CONTRACT, TORT (INCLUDING NEGLIGENCE), OR OTHERWISE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGES.
        </li>
        <li>
          <strong>Aggregate Liability Cap</strong>: TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, OUR TOTAL CUMULATIVE LIABILITY FOR ANY DIRECT, ACTUAL, ORDINARY DAMAGES ARISING OUT OF OR RELATED TO THESE TERMS OR HARDSHELL SOLO GUARDIAN SHALL NOT EXCEED THE <strong>TOTAL SUBSCRIPTION FEES ACTUALLY PAID BY YOU TO US UNDER THESE TERMS DURING THE TWELVE (12) MONTHS IMMEDIATELY PRECEDING THE EVENT GIVING RISE TO LIABILITY</strong>. IF YOU HAVE PAID $0 (INCLUDING DURING A FREE TRIAL OR WHEN USING HARDSHELL COMMUNITY), OUR AGGREGATE LIABILITY SHALL BE ZERO TO THE FULLEST EXTENT PERMITTED BY LAW.
        </li>
        <li>
          <strong>Mandatory Law Carve-Out</strong>: Nothing in these Terms excludes or limits liability for willful misconduct, gross negligence, or any liability that cannot be excluded or limited under mandatory applicable law (including, where applicable, the Consumer Contract Act of Japan). Where a consumer protection statute restricts full exclusion of liability for simple negligence, our liability for simple negligence is limited to direct ordinary damages up to the 12-month fee cap stated above to the maximum extent permitted by law.
        </li>
      </ul>
    </section>

    <section class="hst-section">
      <h2>6. Indemnification</h2>
      <p>
        You agree to defend, indemnify, and hold harmless AOI Future from and against any third-party claims, demands, damages, liabilities, and reasonable legal fees arising out of or related to: (a) your configuration, operation, or approval decisions; (b) scanning or modifying systems without authorization; (c) content or representations you publish via a Public Verified Trust Page; or (d) your breach of these Terms or applicable law—except to the extent directly caused by our willful misconduct or gross negligence.
      </p>
    </section>

    <section class="hst-section">
      <h2>7. Changes, Termination, Assignment, Severability &amp; Governing Law</h2>
      <ul>
        <li><strong>Changes to Terms</strong>: We may update these Terms as the service or applicable law evolves. For material changes, we will post the updated Terms on this page with a revised date and, where appropriate, notify active subscribers by email. Continued use after the effective date constitutes acceptance.</li>
        <li><strong>Service Changes &amp; Discontinuation</strong>: We may modify or discontinue the Relay service with reasonable prior notice. Upon discontinuation, Hardshell Community (MIT) and local evidence remain usable under our Fail-Open guarantee.</li>
        <li><strong>Assignment &amp; Corporate Succession</strong>: We may assign or transfer our rights and obligations under these Terms—without requiring your separate consent—to a newly incorporated entity, affiliate, or successor in connection with incorporation, reorganization, or sale of the business.</li>
        <li><strong>Severability</strong>: If any provision (or part of a provision) of these Terms is held invalid or unenforceable, the remaining provisions and the enforceable remainder of that provision will remain in full force and effect.</li>
        <li><strong>Governing Law &amp; Jurisdiction</strong>: These Terms are governed by the laws of <strong>Japan</strong>, without regard to conflict-of-law principles. Any dispute arising out of or relating to these Terms or Hardshell shall be subject to the exclusive jurisdiction of the <strong>Tokyo District Court</strong> as the court of first instance.</li>
      </ul>
    </section>

    <section class="hst-section" id="legal-notice">
      <h2>8. Legal Notice (Japan — Specified Commercial Transactions Act)</h2>
      <p class="hst-caption">
        Statutory disclosure provided in accordance with Japan's Act on Specified Commercial Transactions (特定商取引法に基づく表記) for global and domestic Stripe transactions.
      </p>
      <dl class="hst-table">
        <div>
          <dt>Operator / Seller</dt>
          <dd>AOI Future (Shugo Nozaki)</dd>
        </div>
        <div>
          <dt>Responsible Person</dt>
          <dd>Shugo Nozaki</dd>
        </div>
        <div>
          <dt>Address &amp; Phone</dt>
          <dd>Disclosed without delay upon request via email (<a href="mailto:legal@aoifuture.com">legal@aoifuture.com</a>).</dd>
        </div>
        <div>
          <dt>Contact</dt>
          <dd>Legal &amp; billing: <a href="mailto:legal@aoifuture.com">legal@aoifuture.com</a><br />Technical support &amp; key re-issuance: <a href="/contact">https://aoifuture.com/contact</a></dd>
        </div>
        <div>
          <dt>Pricing</dt>
          <dd>Hardshell Solo Guardian — Founding: US$19/mo or US$190/yr; Standard: US$29/mo or US$290/yr (applicable taxes and totals shown at Stripe Checkout).</dd>
        </div>
        <div>
          <dt>Additional Costs</dt>
          <dd>Internet connectivity, server hosting, and monitored VPS infrastructure costs are borne by the customer.</dd>
        </div>
        <div>
          <dt>Payment Method &amp; Timing</dt>
          <dd>Credit card via Stripe. Initial charge upon expiration of the 14-day free trial; recurring monthly or annual auto-renewal thereafter.</dd>
        </div>
        <div>
          <dt>Delivery Timing</dt>
          <dd>Digital delivery immediately upon Stripe Checkout completion via email from <code>noreply@hs-mail.aoifuture.com</code>.</dd>
        </div>
        <div>
          <dt>Cancellation &amp; Refunds</dt>
          <dd>Cancel anytime via Stripe Customer Portal before the next billing cycle. No refunds or prorated refunds after billing starts due to the 14-day free trial (except duplicate charges, material defects attributable to us, or statutory rights).</dd>
        </div>
        <div>
          <dt>System Requirements</dt>
          <dd>Linux (Ubuntu / Debian, etc.) or macOS, Python 3.11+ / <code>uv</code>, and outbound HTTPS access for activation and Witness sync.</dd>
        </div>
      </dl>
    </section>

    <footer class="hst-footer">
      <a href="/apps/hardshell/">{'<'} Back to Hardshell</a>
      <a href="/">AOI FUTURE</a>
    </footer>
  </main>
</Layout>

<style>
  .hst-shell { max-width: 860px; margin: auto; padding: 24px 24px 72px; color: var(--aoi-brand); font-family: var(--font-sans); }
  .hst-shell p, .hst-shell li, .hst-shell dt, .hst-shell dd { font-size: var(--fs-body); line-height: var(--lh-body); }
  .hst-shell h1 { font-size: clamp(24px, 3.6vw, 38px); line-height: 1.3; font-weight: 700; margin: 16px 0 12px; }
  .hst-shell h2 { font-size: var(--fs-h2); line-height: 1.45; margin: 0 0 16px; font-weight: 600; }
  .hst-shell p + p { margin-top: 14px; }
  .hst-shell p + ul, .hst-shell ul + p { margin-top: 14px; }
  .hst-shell a { text-underline-offset: 4px; }
  .hst-shell a:hover { text-decoration: underline; }
  .hst-shell code { font-family: var(--font-mono); font-size: 0.92em; background: var(--aoi-brand-05); padding: 2px 6px; }
  .hst-nav, .hst-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
  .hst-nav-links { display: flex; flex-wrap: wrap; gap: 20px; }
  .hst-nav a, .hst-footer a { display: inline-flex; align-items: center; min-height: var(--tap-min); font: var(--fs-label)/1.75 var(--font-mono); }
  .hst-hero { padding: 48px 0 36px; }
  .hst-label { font: var(--fs-label)/1.75 var(--font-mono); letter-spacing: .14em; color: var(--aoi-brand-70); }
  .hst-meta { font-family: var(--font-mono); font-size: 0.88em; color: var(--aoi-brand-70); margin-bottom: 18px; }
  .hst-lead { font-size: var(--fs-lead); line-height: 1.75; color: var(--aoi-brand-90); }
  .hst-caption { font-size: 0.92em; color: var(--aoi-brand-70); margin-bottom: 18px; }
  .hst-caps { font-family: var(--font-mono); font-size: 0.86em !important; line-height: 1.75 !important; border-left: 2px solid var(--aoi-brand-30); padding: 12px 16px; background: var(--aoi-brand-05); }
  .hst-section { padding: 32px 0; border-top: 1px solid var(--aoi-brand-20); }
  .hst-section p, .hst-section li, .hst-section dd { color: var(--aoi-brand-90); }
  .hst-section ul { list-style: disc; padding-left: 20px; }
  .hst-section li + li { margin-top: 10px; }
  .hst-table { margin: 0; border-top: 1px solid var(--aoi-brand-20); }
  .hst-table > div { display: grid; grid-template-columns: 220px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--aoi-brand-15); }
  .hst-table dt { font-weight: 600; color: var(--aoi-brand); }
  .hst-table dd { margin: 0; }
  .hst-footer { border-top: 1px solid var(--aoi-brand-20); padding-top: 24px; margin-top: 32px; }
  @media (max-width: 680px) {
    .hst-table > div { grid-template-columns: 1fr; gap: 6px; }
    .hst-shell { padding: 16px 20px 48px; }
  }
</style>
