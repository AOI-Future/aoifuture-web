---
import Layout from '../../../layouts/Layout.astro';
import { gumroadUrl } from '../../../data/agent-security';

export const prerender = true;

const title = 'Hardshell — Local-First VPS & AI Agent Security Hardening | AOI Future';
const description =
  'Open-core Linux VPS & AI agent security for solo founders: local-first scanning, Docker-UFW bypass audits, hardshell guard AI cost circuit breaker, plus Solo Guardian (14-day free trial) with Out-of-Band Witness, Public Verified Trust Page, and 1-Tap HCAP v0.2 approval.';

const relayBase = 'https://hardshell.aoifuture.com';
const checkoutSessionEndpoint = `${relayBase}/v1/checkout/session`;
const checkoutUrls = {
  foundingMonthly: `${relayBase}/checkout?plan=solo_monthly_founding`,
  foundingYearly: `${relayBase}/checkout?plan=solo_yearly_founding`,
  standardMonthly: `${relayBase}/checkout?plan=solo_monthly`,
  standardYearly: `${relayBase}/checkout?plan=solo_yearly`,
};

const roles = [
  {
    no: '01',
    label: 'SCAN & AUDIT (COMMUNITY / MIT)',
    name: 'Audit host config, Docker-UFW bypasses, and AI/MCP posture',
    text: 'Wraps Trivy, Grype, Lynis, and Nuclei alongside built-in checks for SSH, firewall, Docker-UFW bypasses, and AI agent/MCP runtime exposure. Runs locally with zero account required.',
  },
  {
    no: '02',
    label: 'ENRICH & GUARD (COMMUNITY / MIT)',
    name: 'Prioritize with CTI and stop runaway AI agent spend locally',
    text: 'Enriches findings with EPSS, CISA KEV, OSV/GHSA, and PHP/nginx early-warning advisories. hardshell guard acts as a local circuit breaker for runaway agent loops and API cost spikes.',
  },
  {
    no: '03',
    label: 'WITNESS & TRUST PAGE (SOLO GUARDIAN)',
    name: 'Anchor tamper-evident posture outside your VPS and share proof',
    text: 'Sends signed posture summaries (hardshell.posture_summary.v1) to an off-host Out-of-Band Witness and maintains a Public Verified Trust Page you can link from your README or product footer.',
  },
  {
    no: '04',
    label: 'BOUNDED APPROVAL (SOLO GUARDIAN)',
    name: '1-Tap HCAP v0.2 approval with pre-change rollback broker',
    text: 'Privileged remediations require dual Ed25519 signatures and explicit human approval. Captures pre-change rollback state before applying bounded fixes—never silent auto-mutation.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://aoifuture.com/apps/hardshell/#software',
      name: 'Hardshell',
      alternateName: ['Hardshell Community', 'Hardshell Solo Guardian'],
      applicationCategory: 'SecurityApplication',
      applicationSubCategory: 'VPS Hardening and AI Agent Runtime Defense',
      operatingSystem: 'Linux, macOS',
      softwareRequirements: 'Python 3.11+, uv',
      license: 'https://opensource.org/license/mit',
      url: 'https://aoifuture.com/apps/hardshell/',
      codeRepository: 'https://github.com/0xshugo/hardshell',
      termsOfService: 'https://aoifuture.com/apps/hardshell/terms',
      description,
      author: {
        '@type': 'Person',
        name: 'Shugo Nozaki',
        url: 'https://nozaki.com',
      },
      publisher: {
        '@type': 'Organization',
        name: 'AOI Future',
        url: 'https://aoifuture.com',
      },
      featureList: [
        'Linux VPS security hardening and Docker-UFW bypass audit',
        'Trivy, Grype, Lynis, and Nuclei aggregation enriched with EPSS, CISA KEV, OSV/GHSA, and PHP/nginx early-warning advisories',
        'hardshell guard local AI agent runaway and API cost circuit breaker',
        'Signed posture summary export (hardshell.posture_summary.v1) and HCAP v0.2 local execution boundaries',
        'Solo Guardian: Ed25519 offline-verifiable entitlements (up to 3 VPS nodes), Out-of-Band Witness, Public Verified Trust Page, and 1-Tap HCAP approval',
        'Fail-open guarantee: Community scans, VPS uptime, and local evidence exports never stop on subscription expiry or Relay outage',
      ],
      offers: [
        {
          '@type': 'Offer',
          sku: 'hardshell-community',
          name: 'Hardshell Community (MIT)',
          price: '0',
          priceCurrency: 'USD',
          url: 'https://github.com/0xshugo/hardshell',
          availability: 'https://schema.org/InStock',
        },
        {
          '@type': 'Offer',
          sku: 'solo_monthly_founding',
          name: 'Hardshell Solo Guardian — Founding Monthly (14-day free trial)',
          price: '19',
          priceCurrency: 'USD',
          url: checkoutUrls.foundingMonthly,
          availability: 'https://schema.org/InStock',
          eligibleQuantity: { '@type': 'QuantitativeValue', value: 3, unitText: 'VPS nodes' },
          potentialAction: {
            '@type': 'BuyAction',
            target: {
              '@type': 'EntryPoint',
              urlTemplate: checkoutUrls.foundingMonthly,
              actionPlatform: [
                'http://schema.org/DesktopWebPlatform',
                'http://schema.org/MobileWebPlatform',
              ],
            },
          },
        },
        {
          '@type': 'Offer',
          sku: 'solo_yearly_founding',
          name: 'Hardshell Solo Guardian — Founding Yearly (14-day free trial)',
          price: '190',
          priceCurrency: 'USD',
          url: checkoutUrls.foundingYearly,
          availability: 'https://schema.org/InStock',
          eligibleQuantity: { '@type': 'QuantitativeValue', value: 3, unitText: 'VPS nodes' },
          potentialAction: {
            '@type': 'BuyAction',
            target: checkoutUrls.foundingYearly,
          },
        },
        {
          '@type': 'Offer',
          sku: 'solo_monthly',
          name: 'Hardshell Solo Guardian — Standard Monthly (14-day free trial)',
          price: '29',
          priceCurrency: 'USD',
          url: checkoutUrls.standardMonthly,
          availability: 'https://schema.org/InStock',
          eligibleQuantity: { '@type': 'QuantitativeValue', value: 3, unitText: 'VPS nodes' },
          potentialAction: {
            '@type': 'BuyAction',
            target: checkoutUrls.standardMonthly,
          },
        },
        {
          '@type': 'Offer',
          sku: 'solo_yearly',
          name: 'Hardshell Solo Guardian — Standard Yearly (14-day free trial)',
          price: '290',
          priceCurrency: 'USD',
          url: checkoutUrls.standardYearly,
          availability: 'https://schema.org/InStock',
          eligibleQuantity: { '@type': 'QuantitativeValue', value: 3, unitText: 'VPS nodes' },
          potentialAction: {
            '@type': 'BuyAction',
            target: checkoutUrls.standardYearly,
          },
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is the difference between Hardshell Community (free) and Solo Guardian (paid)?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Hardshell Community (MIT, $0 forever, no signup) includes Linux VPS scanning, Docker-UFW bypass audits, EPSS/KEV/OSV/GHSA and PHP/nginx early-warning triage, hardshell guard (local AI runaway & cost circuit breaker), signed posture export, and HCAP v0.2 local boundaries. Solo Guardian ($19/mo Founding or $29/mo Standard, 14-day free trial, up to 3 VPS nodes) adds Ed25519 offline-verifiable entitlements, off-host Out-of-Band Witness, a Public Verified Trust Page, and 1-Tap HCAP v0.2 approval with pre-change rollback.',
          },
        },
        {
          '@type': 'Question',
          name: 'What happens if I cancel Solo Guardian or the Relay goes offline?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Hardshell is fail-open by design. Canceling your subscription or experiencing a Relay outage never stops Hardshell Community scans, your monitored VPS workloads, or local viewing and exporting of existing evidence. Only commercial Solo Guardian add-ons (new Witness updates and 1-Tap HCAP approvals) stop.',
          },
        },
        {
          '@type': 'Question',
          name: 'How can an AI agent initiate a Hardshell Solo Guardian purchase on behalf of a human?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Fetch the machine-readable manifest at https://aoifuture.com/apps/hardshell/agent.json or https://aoifuture.com/products.json, then call POST https://hardshell.aoifuture.com/v1/checkout/session with JSON {"plan":"solo_monthly_founding"} (or solo_yearly_founding, solo_monthly, solo_yearly) to receive a live Stripe Checkout URL (14-day free trial) for human approval and payment.',
          },
        },
        {
          '@type': 'Question',
          name: 'How do the 14-day free trial and refund policy work?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Every Solo Guardian subscription starts with a 14-day free trial via Stripe. Cancel anytime during the trial in the Stripe Customer Portal at zero cost. Because of the 14-day free trial, charges after billing begins are non-refundable and non-prorated except for duplicate billing, material defects attributable to us, or statutory rights (see https://aoifuture.com/apps/hardshell/terms).',
          },
        },
        {
          '@type': 'Question',
          name: 'How is Hardshell different from the AI-Agent Security Verification Kit ($129)?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'They are complementary. The AI-Agent Security Verification Kit ($129 one-time on Gumroad) generates design and requirements verification artifacts (JSON, PDF, digest manifest, RFC 3161 timestamps). Hardshell provides continuous production Linux VPS and local AI-agent runtime hardening, guardrails, and an off-host Trust Page.',
          },
        },
      ],
    },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical="https://aoifuture.com/apps/hardshell/"
  pageTransition={false}
  lang="en"
>
  <Fragment slot="head">
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://aoifuture.com/apps/hardshell/" />
    <meta property="og:locale" content="en_US" />
    <link rel="alternate" type="application/json" href="/apps/hardshell/agent.json" title="Hardshell Agentic Commerce Manifest" />
    <link rel="alternate" type="application/vnd.oai.openapi+json" href="/apps/hardshell/openapi.json" title="Hardshell Relay OpenAPI 3.1 Specification" />
    <link rel="alternate" type="application/json" href="/.well-known/agent-card.json" title="AOI Future A2A Agent Discovery Card" />
    <link rel="alternate" type="application/json" href="/products.json" title="AOI Future Product Catalog" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <a class="hs-skip" href="#content">Skip to main content</a>
  <main class="hs-shell" id="content">
    <nav class="hs-nav" aria-label="Related pages">
      <a href="/apps/">{'<'} APPS</a>
      <div class="hs-nav-links">
        <a href="#agentic-commerce">For AI Agents</a>
        <a href="/apps/hardshell/terms">Terms &amp; Legal</a>
        <a href="/agent-security/">AI Agent Security {'>'}</a>
      </div>
    </nav>

    <p class="hs-status-banner" id="hs-status-banner">
      <strong>[EARLY ACCESS / BEST-EFFORT · NO SLA]</strong> Open-source Community (MIT) available · Solo Guardian Founding ($19/mo · 14-day free trial) live via Stripe · Agentic Commerce manifest at <code>/apps/hardshell/agent.json</code>
    </p>
    <div class="hs-checkout-notice" id="hs-checkout-notice" hidden></div>

    <header class="hs-hero">
      <p class="hs-label">HARDSHELL / COMMUNITY &amp; SOLO GUARDIAN</p>
      <h1>Inspect self-hosted VPS &amp; AI agents locally.<br />Share signed posture snapshots.</h1>
      <p class="hs-lead">
        An assistive security posture inspection, visibility, and human-approval workflow tool built for solo AI founders running Coolify, Docker, n8n, OpenClaw, or custom MCP agents on self-hosted Linux servers. Runs local configuration checks and operator-configured AI guardrails—then pairs with Solo Guardian (Early Access, best-effort, no SLA) for off-host Witness snapshots, a Public Posture Status Page, and 1-Tap HCAP v0.2 human approvals.
      </p>
      <div class="hs-actions">
        <a class="hs-button hs-primary" href={checkoutUrls.foundingMonthly} rel="noopener noreferrer">
          Start 14-Day Free Trial (Founding $19/mo)
        </a>
        <a class="hs-button" href="https://github.com/0xshugo/hardshell" target="_blank" rel="noopener noreferrer">
          Use Community Free on GitHub (MIT)
        </a>
        <a class="hs-button" href="#pricing">Compare Plans</a>
      </div>
      <p class="hs-caption">
        Early Access · Best-effort support · No SLA · Not for high-risk/mission-critical environments. Powered by Stripe Checkout (14-day free trial, cancel anytime). Fail-open by design: expiration or Relay outages never stop Community scans, your VPS, or local evidence exports.
      </p>
    </header>

    <section aria-labelledby="why-title" class="hs-section">
      <p class="hs-label">WHY HARDSHELL</p>
      <h2 id="why-title">Spot drift and misconfigurations early. Inspect locally, keep humans in control.</h2>
      <div class="hs-grid">
        <article>
          <h3>Local-first audits &amp; AI guardrails</h3>
          <p>Combines Trivy, Grype, Lynis, Nuclei, and Docker-UFW bypass checks with EPSS/KEV/OSV/GHSA and PHP/nginx early warnings. <code>hardshell guard</code> adds operator-configured local rate/budget guardrails (heuristic assist, not infallible AI protection).</p>
        </article>
        <article>
          <h3>Off-host Witness &amp; Trust Page</h3>
          <p>Solo Guardian anchors your cryptographically signed self-audit summaries (<code>hardshell.posture_summary.v1</code>) outside the monitored VPS and publishes a Public Posture / Trust Page (transparent self-inspection snapshot, not a third-party certification).</p>
        </article>
        <article>
          <h3>Honest visibility, never fake green</h3>
          <p>Explicitly records skipped checks, stale feeds, and collection gaps so "zero findings" is never mistaken for "safe". Privileged changes require signed HCAP v0.2 approval.</p>
        </article>
      </div>
    </section>

    <section aria-labelledby="roles-title" class="hs-section">
      <p class="hs-label">ARCHITECTURE / OPEN-CORE</p>
      <h2 id="roles-title">Open-source host defense separated from commercial off-host proof.</h2>
      <ol class="hs-flow">
        {roles.map((role) => (
          <li>
            <span class="hs-label">{role.no} / {role.label}</span>
            <div>
              <h3>{role.name}</h3>
              <p>{role.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="hs-note">
        <strong>Fail-Open for Community / Fail-Closed for Privileged Actions:</strong> Billing state or external Relay availability never halts Community scans or production servers. Conversely, privileged remediations never execute without cryptographic signature verification and explicit approval.
      </p>
    </section>

    <section id="pricing" aria-labelledby="pricing-title" class="hs-section">
      <p class="hs-label">PLANS &amp; PRICING (USD)</p>
      <h2 id="pricing-title">Start free with Community (MIT). Upgrade to Solo Guardian when you need external proof.</h2>
      <div class="hs-two">
        <article class="hs-status">
          <p class="hs-label">COMMUNITY / MIT LICENSE</p>
          <h3>$0 — Free forever, no account required</h3>
          <p>Free for individuals and commercial teams under the MIT License.</p>
          <ul>
            <li>Unified VPS audits (System / Docker-UFW / Trivy / Grype / Lynis / Nuclei)</li>
            <li>EPSS / CISA KEV / OSV / GHSA / PHP &amp; nginx early-warning triage</li>
            <li><code>hardshell guard</code> local AI runaway &amp; API cost circuit breaker</li>
            <li>Signed posture summary export &amp; HCAP v0.2 local execution boundaries</li>
          </ul>
          <pre class="hs-code"><code>git clone https://github.com/0xshugo/hardshell
cd hardshell &amp;&amp; uv sync
uv run hardshell status</code></pre>
          <div class="hs-actions">
            <a class="hs-button" href="https://github.com/0xshugo/hardshell" target="_blank" rel="noopener noreferrer">
              View Community on GitHub {'>'}
            </a>
          </div>
        </article>

        <article class="hs-status hs-featured">
          <p class="hs-label">SOLO GUARDIAN / EARLY ACCESS · BEST-EFFORT · NO SLA</p>
          <h3>Founding $19/mo · Standard $29/mo</h3>
          <p>Early Access commercial add-on for solo AI founders running up to 3 self-hosted VPS nodes (best-effort support, no SLA, not for mission-critical/regulated systems). 14-day free trial; save 2 months annually (Founding $190/yr · Standard $290/yr).</p>
          <ul>
            <li>Ed25519 offline-verifiable license entitlements (up to 3 VPS nodes)</li>
            <li>Out-of-Band Witness outside your monitored VPS</li>
            <li>Public Verified Trust Page for customers and partners</li>
            <li>1-Tap HCAP v0.2 approval &amp; pre-change rollback broker</li>
            <li>Self-serve billing, invoices, and cancellation via Stripe Customer Portal</li>
          </ul>
          <div class="hs-plan-links">
            <a class="hs-button hs-primary" href={checkoutUrls.foundingMonthly} rel="noopener noreferrer">
              Founding $19/mo (14-day trial)
            </a>
            <a class="hs-button" href={checkoutUrls.foundingYearly} rel="noopener noreferrer">
              Founding $190/yr (14-day trial)
            </a>
            <a class="hs-button" href={checkoutUrls.standardMonthly} rel="noopener noreferrer">
              Standard $29/mo (14-day trial)
            </a>
            <a class="hs-button" href={checkoutUrls.standardYearly} rel="noopener noreferrer">
              Standard $290/yr (14-day trial)
            </a>
          </div>
          <p class="hs-caption">
            After checkout, <code>noreply@hs-mail.aoifuture.com</code> delivers your license key once (plaintext keys are never stored in the Relay DB). Review <a href="/apps/hardshell/terms">Terms of Service &amp; Legal Notice</a>.
          </p>
        </article>
      </div>

      <div class="hs-note" id="team">
        <p class="hs-label">PHASE 2 / TEAM &amp; BUSINESS</p>
        <h3>Multi-user teams &amp; enterprise governance (in preparation)</h3>
        <p>
          Need multi-member asset registries, OIDC/IdP integration, independent exception approvals (self-approval blocked), and long-term audit exports? Team / Business is in preparation as Phase 2. Reach out for pilot deployments or custom verification sprints.
        </p>
        <div class="hs-actions">
          <a class="hs-button" href="/contact">Contact for Team Pilot or Support {'>'}</a>
        </div>
      </div>
    </section>

    <section id="agentic-commerce" aria-labelledby="agentic-title" class="hs-section">
      <p class="hs-label">AGENTIC COMMERCE / MACHINE-READABLE API</p>
      <h2 id="agentic-title">Built for AI shopping &amp; DevOps agents (Human-in-the-Loop Checkout).</h2>
      <p>
        AI assistants and autonomous DevOps agents can inspect Hardshell's full pricing, boundaries, and terms in structured JSON, then programmatically mint a live Stripe Checkout Session URL (14-day free trial) for human review and payment confirmation.
      </p>
      <div class="hs-two">
        <article class="hs-status">
          <p class="hs-label">DISCOVERY ENDPOINTS</p>
          <h3>Machine-readable specs</h3>
          <ul>
            <li>Product manifest: <a href="/apps/hardshell/agent.json"><code>GET https://aoifuture.com/apps/hardshell/agent.json</code></a></li>
            <li>Full catalog: <a href="/products.json"><code>GET https://aoifuture.com/products.json</code></a></li>
            <li>Agent overview: <a href="/llms.txt"><code>GET https://aoifuture.com/llms.txt</code></a></li>
            <li>Relay health: <code>GET https://hardshell.aoifuture.com/healthz</code></li>
            <li>Terms &amp; refund rules: <a href="/apps/hardshell/terms"><code>https://aoifuture.com/apps/hardshell/terms</code></a></li>
          </ul>
        </article>
        <article class="hs-status">
          <p class="hs-label">PROGRAMMATIC CHECKOUT</p>
          <h3>Mint a Stripe Checkout Session</h3>
          <p>Valid <code>plan</code> keys: <code>solo_monthly_founding</code> ($19/mo), <code>solo_yearly_founding</code> ($190/yr), <code>solo_monthly</code> ($29/mo), <code>solo_yearly</code> ($290/yr).</p>
          <pre class="hs-code"><code>curl -sS -X POST {checkoutSessionEndpoint}   -H 'Content-Type: application/json'   -d '{'{"plan":"solo_monthly_founding"}'}'</code></pre>
          <p class="hs-caption">
            Returns JSON <code>{'{"url","session_id","plan","tier","interval","trial_period_days":14,"livemode":true}'}</code>. Present <code>url</code> to the human operator for approval and card entry. Direct browser redirect is also available at <code>GET {relayBase}/checkout?plan=solo_monthly_founding</code>.
          </p>
        </article>
      </div>
    </section>

    <section id="scope" aria-labelledby="scope-title" class="hs-section">
      <p class="hs-label">TRANSPARENCY / SCOPE &amp; BOUNDARIES</p>
      <h2 id="scope-title">What is verified today—and what we honestly do not claim.</h2>
      <div class="hs-two">
        <article class="hs-status">
          <p class="hs-label">VERIFIED / CURRENT</p>
          <h3>Implemented &amp; live</h3>
          <ul>
            <li>OSS Core: Linux VPS scanning, Docker-UFW bypass audit, EPSS/KEV/OSV/GHSA, PHP/nginx early warning, <code>hardshell guard</code>, signed posture export, HCAP v0.2 boundaries.</li>
            <li>Solo Guardian Relay: <code>hardshell.aoifuture.com</code> live on Fly.io (Tokyo <code>nrt</code>), Stripe Checkout broker &amp; idempotent webhook processor, Ed25519 offline entitlements, Witness / Trust Page, and one-time Resend delivery (<code>hs-mail.aoifuture.com</code>).</li>
            <li>Graceful degradation: Community scans, VPS uptime, and local evidence exports never stop on expiry or Relay outage.</li>
          </ul>
        </article>
        <article class="hs-status">
          <p class="hs-label">BOUNDARIES / NON-GUARANTEES</p>
          <h3>Explicit non-guarantees</h3>
          <ul>
            <li>Hardshell and Public Verified Trust Pages are assistive tools—not a third-party security certification (SOC 2 / ISO 27001) or a guarantee against breaches.</li>
            <li>Local log integrity checks cannot physically prevent tampering by a compromised root user on the same host (use Out-of-Band Witness for external anchoring).</li>
            <li>Full warranty disclaimers, liability cap, indemnification, and legal notice are published at <a href="/apps/hardshell/terms">/apps/hardshell/terms</a>.</li>
          </ul>
        </article>
      </div>
    </section>

    <section aria-labelledby="relation-title" class="hs-section">
      <p class="hs-label">RELATED / AI AGENT SECURITY</p>
      <h2 id="relation-title">Design-time verification meets continuous VPS defense.</h2>
      <div class="hs-two">
        <article>
          <h3>AI Agent Security Reference &amp; Verification Kit ($129)</h3>
          <p>
            Threat taxonomy (TH-01..TH-10), free 20-question self-assessment checklist, and a one-time paid Verification Kit generating reviewable JSON, PDF, digest-manifest, and RFC 3161 timestamp artifacts. Complementary to Hardshell's runtime VPS defense.
          </p>
          <div class="hs-actions">
            <a class="hs-button" href="/agent-security/">Explore AI Agent Security Hub {'>'}</a>
            <a class="hs-button" href={gumroadUrl('hardshell_kit')} target="_blank" rel="noopener noreferrer">Verification Kit ($129) {'>'}</a>
          </div>
        </article>
        <article>
          <h3>Terms, Legal Notice &amp; Support</h3>
          <p>
            Review trial, renewal, cancellation, refund, data handling, liability, and statutory terms at <a href="/apps/hardshell/terms">/apps/hardshell/terms</a>. For technical support or license key re-issuance, use <a href="/contact">/contact</a>.
          </p>
          <div class="hs-actions">
            <a class="hs-button hs-primary" href="/apps/hardshell/terms">Terms &amp; Legal Notice {'>'}</a>
            <a class="hs-button" href="/contact">Support (/contact) {'>'}</a>
          </div>
        </article>
      </div>
    </section>

    <footer class="hs-footer">
      <a href="/">AOI FUTURE</a>
      <p>Hardshell · Community (MIT) / Solo Guardian</p>
      <div class="hs-nav-links">
        <a href="/apps/hardshell/agent.json">agent.json</a>
        <a href="/apps/hardshell/terms">Terms &amp; Legal</a>
        <a href="/agent-security/">AI Agent Security</a>
      </div>
    </footer>
  </main>

  <script is:inline>
    (() => {
      const params = new URLSearchParams(window.location.search);
      const state = params.get('checkout');
      const notice = document.getElementById('hs-checkout-notice');
      if (!notice || !state) return;
      if (state === 'success') {
        notice.hidden = false;
        notice.innerHTML =
          '<strong>Checkout complete.</strong> Your one-time license key and setup instructions have been emailed from <code>noreply@hs-mail.aoifuture.com</code>. If you do not see it, check spam or contact <a href="/contact">/contact</a>.';
      } else if (state === 'canceled') {
        notice.hidden = false;
        notice.innerHTML =
          '<strong>Checkout canceled.</strong> You have not been charged. You can start your 14-day free trial anytime from the pricing section below.';
      }
    })();
  </script>
</Layout>

